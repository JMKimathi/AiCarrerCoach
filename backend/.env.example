# Copy to .env. Keep .env private and never commit it.
# start.ps1 creates a random SECRET_KEY automatically on first run.
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
# Optional: omit this to use backend/career_coach.db (SQLite).
# DATABASE_URL=sqlite:///C:/absolute/path/to/backend/career_coach.db
# Optional; chat uses authored resource retrieval when this is not configured.
GEMINI_API_KEY=
